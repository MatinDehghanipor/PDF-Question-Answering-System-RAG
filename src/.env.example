# PDF QA System — environment configuration
# Copy to .env and adjust.  Every value maps to app/core/config.py (NFR-25).

# --- General ---
APP_NAME=PDF QA System
APP_ENV=development
DEBUG=false

# --- Database (SQLite by default; PostgreSQL is a future migration path) ---
DATABASE_URL=sqlite:///./data/app.db

# --- Auth (used from Phase 1) ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- File upload (Phase 2) ---
MAX_UPLOAD_SIZE_MB=100

# --- Chunking (Phase 6 — OD-1) ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Retrieval (Phase 7 — OD-2) ---
DEFAULT_TOP_K=5
MIN_TOP_K=1
MAX_TOP_K=20

# --- Quality score (Phase 3 — OD-3) ---
QUALITY_SCORE_THRESHOLD=0.6

# --- Embeddings / vector store (Phase 6) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store

# --- LLMs (Phases 5, 7, 8 — OD-12) ---
LLM_ANSWER_MODEL=gemini-2.0-flash
LLM_REVIEW_MODEL=gemini-2.0-flash

# --- Raw Mode (Phase 8 — OD-7) ---
RAW_MODE_MAX_FILE_MB=50
RAW_MODE_MAX_PAGES=100

# --- File storage ---
FILE_STORAGE_PATH=./data/pdfs